# Gmail SMTP (App Password from Google Account > Security > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Auth
API_KEY=
CRON_SECRET=
AUTH_MODE=open   # open | secure
ALLOWED_ORIGIN=*

# Firebase service account (from the JSON file)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Tuning (all optional)
CONCURRENCY=3
MAX_BATCH=100
TIME_BUDGET_MS=45000
LEASE_MS=90000
MAX_ATTEMPTS=4
RETENTION_DAYS=7
DAILY_LIMIT=450
USER_DAILY_LIMIT=20
PUBLIC_DAILY_LIMIT=10
MAX_RECIPIENTS=50
MAX_BODY_CHARS=500000
